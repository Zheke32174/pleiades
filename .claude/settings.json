{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(free *)",
      "Bash(df -h*)",
      "Bash(du -sh*)",
      "Bash(swapon --show*)",
      "Bash(uname *)",

      "Bash(git status*)",
      "Bash(git status --porcelain*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git remote*)",

      "Bash(systemctl status*)",
      "Bash(systemctl list-units*)",
      "Bash(systemctl is-active*)",
      "Bash(systemctl --failed*)",

      "Bash(awk *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find /workspaces/* *)",
      "Bash(find . *)",

      "Bash(cat /run/purple-gentoo-heartbeat/status)",
      "Bash(cat /run/purple/zod_mode)",

      "Bash(git push origin *)",
      "Bash(git fetch*)",
      "Bash(git pull --rebase*)",
      "Bash(git checkout *)",
      "Bash(git branch -d *)",
      "Bash(git branch --show-current*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create*)",
      "Bash(gh api repos/* *)",
      "Bash(gh auth status*)",

      "Bash(jq *)",
      "Bash(python3 -c *)",

      "Read(/workspaces/**)",
      "Read(/run/purple-gentoo-heartbeat/status)",
      "Read(/run/purple/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/gentoo/.claude/hooks/session-start-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/gentoo/.claude/hooks/pre-tool-credential-scan.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/gentoo/.claude/hooks/session-end-summary.sh"
          }
        ]
      }
    ]
  }
}
