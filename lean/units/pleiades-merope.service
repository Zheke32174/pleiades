[Unit]
Description=Pleiades Merope — encrypted, signed snapshot of the trust state
After=pleiades-maia.service
OnFailure=pleiades-celaeno-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/merope-rebirth.sh snapshot

RuntimeDirectory=pleiades
RuntimeDirectoryPreserve=yes
StateDirectory=maia

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/maia /run/pleiades
