[Unit]
Description=Pleiades Merope — encrypted, signed snapshot of the trust state
After=pleiades-maia.service
OnFailure=pleiades-celaeno-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/merope-rebirth.sh snapshot
Slice=pleiades.slice
UMask=0077

RuntimeDirectory=pleiades
RuntimeDirectoryPreserve=yes
StateDirectory=maia

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/maia /run/pleiades
