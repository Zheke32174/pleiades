[Unit]
Description=Pleiades Alcyone — read-only recon / posture snapshot
After=pleiades-maia.service
OnFailure=pleiades-celaeno-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/alcyone-recon.sh recon
Slice=pleiades.slice
UMask=0077

RuntimeDirectory=pleiades
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ReadWritePaths=/run/pleiades
