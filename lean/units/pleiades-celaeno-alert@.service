[Unit]
Description=Pleiades Celaeno — failure alert for %i

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/celaeno-watch.sh alert %i
Slice=pleiades.slice
UMask=0077

StateDirectory=celaeno
RuntimeDirectory=pleiades
RuntimeDirectoryPreserve=yes

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ReadWritePaths=/run/pleiades
