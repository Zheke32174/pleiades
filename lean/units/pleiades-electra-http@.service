[Unit]
Description=Pleiades Electra decoy-http handler (%i)
After=pleiades-maia.service

[Service]
ExecStart=/usr/local/sbin/electra-decoy.sh http %i
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=15
MemoryMax=32M
CPUQuota=10%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=pleiades
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/pleiades
