[Unit]
Description=Pleiades Maia — periodic signed liveness checkpoint
After=pleiades-maia.service
Requires=pleiades-maia.service
OnFailure=pleiades-celaeno-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/maia-overseer.sh checkpoint
Slice=pleiades.slice

RuntimeDirectory=pleiades
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=maia
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/maia /run/pleiades
