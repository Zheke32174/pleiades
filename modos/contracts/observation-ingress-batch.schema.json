{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/modos-observation-ingress-batch-v1.json",
  "title": "MODOS Observation Ingress Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "delivery", "events", "integrity", "proof"],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "ObservationIngressBatch"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchId", "traceId", "producerPrincipalId", "receiverPrincipalId", "deliveryStreamId", "adapterClass", "sourceSchema", "createdAt", "expiresAt"],
      "properties": {
        "batchId": {"type": "string", "minLength": 1},
        "traceId": {"type": "string", "minLength": 1},
        "producerPrincipalId": {"type": "string", "minLength": 1},
        "receiverPrincipalId": {"type": "string", "minLength": 1},
        "deliveryStreamId": {"type": "string", "minLength": 1},
        "adapterClass": {"enum": ["android-termux", "windows-host", "linux-host", "application", "sensor", "custom"]},
        "sourceSchema": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "notBefore": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstSequence", "lastSequence", "eventCount", "encodedBytes"],
      "properties": {
        "firstSequence": {"type": "integer", "minimum": 1},
        "lastSequence": {"type": "integer", "minimum": 1},
        "eventCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "encodedBytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deliverySequence", "eventId", "eventDigest", "record"],
        "properties": {
          "deliverySequence": {"type": "integer", "minimum": 1},
          "eventId": {"type": "string", "minLength": 1},
          "eventDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sourcePosition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "position"],
            "properties": {
              "namespace": {"type": "string", "minLength": 1},
              "epoch": {"type": "string", "minLength": 1},
              "position": {"type": "string", "minLength": 1}
            }
          },
          "record": {"type": "object"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization", "digestAlgorithm", "batchDigest"],
      "properties": {
        "canonicalization": {"const": "modos-canonical-json-v1"},
        "digestAlgorithm": {"const": "sha256"},
        "batchDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["transport-bound", "detached-signature"]},
        "keyId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "signature": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "detached-signature"}}},
          "then": {"required": ["keyId", "algorithm", "signature"]}
        },
        {
          "if": {"properties": {"mode": {"const": "transport-bound"}}},
          "then": {"not": {"anyOf": [{"required": ["keyId"]}, {"required": ["algorithm"]}, {"required": ["signature"]}]}}
        }
      ]
    }
  }
}
