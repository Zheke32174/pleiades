{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/modos-domain-event-v1.json",
  "title": "MODOS Signed Domain Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "payload", "signature"],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "SignedDomainEvent"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "domainId", "sourceIdentity", "createdAt", "traceId", "eventType", "sequence", "body", "provenance"],
      "properties": {
        "eventId": {"type": "string", "minLength": 1},
        "domainId": {"type": "string", "minLength": 1},
        "sourceIdentity": {"type": "string", "minLength": 1},
        "sourceBootId": {"type": "string"},
        "createdAt": {"type": "string", "format": "date-time"},
        "traceId": {"type": "string", "minLength": 1},
        "eventType": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "sequence": {"type": "integer", "minimum": 1},
        "body": {"type": "object"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceRef", "sourceDigest", "trust", "visibility"],
          "properties": {
            "sourceRef": {"type": "string", "minLength": 1},
            "sourceDigest": {"type": "string", "minLength": 1},
            "trust": {"enum": ["untrusted", "observed", "corroborated", "verified", "canonical"]},
            "visibility": {"enum": ["public", "internal", "private", "secret", "model-only", "steward-only"]},
            "lineage": {"type": "array", "items": {"type": "string"}}
          }
        },
        "causedByEventRefs": {"type": "array", "items": {"type": "string"}},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
