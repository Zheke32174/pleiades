{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://pleiades.local/schemas/modos-evidence-record-v1.json","title":"MODOS Evidence Record","type":"object","additionalProperties":false,"required":["apiVersion","kind","metadata","claim","method","result","epistemics","security","provenance"],"properties":{"apiVersion":{"const":"modos.pleiades/v1alpha1"},"kind":{"const":"EvidenceRecord"},"metadata":{"type":"object","additionalProperties":false,"required":["evidenceId","mindId","workOrderId","subjectRef","producerRef","observedAt","traceId"],"properties":{"evidenceId":{"type":"string","minLength":1},"mindId":{"type":"string","minLength":1},"workOrderId":{"type":"string","minLength":1},"stageId":{"type":"string","minLength":1},"subjectRef":{"type":"string","minLength":1},"producerRef":{"type":"string","minLength":1},"observedAt":{"type":"string","format":"date-time"},"traceId":{"type":"string","minLength":1}}},"claim":{"type":"object","additionalProperties":false,"required":["type","statement"],"properties":{"type":{"enum":["observation","test","measurement","inference","model-judgment","policy-decision","steward-decision"]},"statement":{"type":"string","minLength":1,"maxLength":8192},"claimRef":{"type":"string","minLength":1}}},"method":{"type":"object","additionalProperties":false,"required":["name","inputRefs","environmentRef"],"properties":{"name":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"inputRefs":{"type":"array","items":{"type":"string","minLength":1}},"environmentRef":{"type":"string","minLength":1},"procedureRef":{"type":"string","minLength":1}}},"result":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["pass","fail","inconclusive","observed"]},"measurements":{"type":"object","additionalProperties":{"type":["integer","string","boolean","null"]}},"artifactRefs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"contradictionRefs":{"type":"array","uniqueIte