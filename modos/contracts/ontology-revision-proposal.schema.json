{
  "$id": "https://pleiades.local/schemas/modos-ontology-revision-proposal-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MODOS Ontology Revision Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "modos.pleiades/v1alpha1"
    },
    "kind": {
      "const": "OntologyRevisionProposal"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "mindId",
        "generatedAt",
        "steward",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mindId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "steward": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "contested",
            "experimental",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "branchRef": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "diagnosis",
        "change",
        "plurality",
        "alternatives",
        "proofObligations",
        "review",
        "invariants"
      ],
      "properties": {
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "summary",
            "evidenceRefs",
            "recurrenceCount",
            "affectedScopes",
            "observedResiduals"
          ],
          "properties": {
            "kind": {
              "enum": [
                "anomaly-cluster",
                "repeated-collapse",
                "semantic-uncertainty",
                "cross-model-disagreement",
                "reasoning-misalignment",
                "user-correction",
                "failed-action",
                "ontology-conflict",
                "external-research"
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "recurrenceCount": {
              "type": "integer",
              "minimum": 1
            },
            "affectedScopes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observedResiduals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "description",
                  "consequence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "currentClassification": {
                    "type": "string"
                  },
                  "consequence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "semanticEntropy": {
                  "type": "number",
                  "minimum": 0
                },
                "interModelDisagreement": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "intraModelVariation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "reasoningAlignment": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "answerAgreement": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failureLayers",
            "hermeneuticalGap",
            "currentConceptRefs",
            "rationale"
          ],
          "properties": {
            "failureLayers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "task",
                  "method",
                  "knowledge",
                  "vocabulary",
                  "boundary",
                  "evidence",
                  "coordination"
                ]
              }
            },
            "hermeneuticalGap": {
              "type": "boolean"
            },
            "falseBinary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "left",
                "right",
                "missingMiddle"
              ],
              "properties": {
                "left": {
                  "type": "string",
                  "minLength": 1
                },
                "right": {
                  "type": "string",
                  "minLength": 1
                },
                "missingMiddle": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "currentConceptRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "intent",
            "atomicChanges",
            "preservesRefs",
            "weakensRefs",
            "deprecatesRefs",
            "resultingConcepts"
          ],
          "properties": {
            "operation": {
              "enum": [
                "add-distinction",
                "split-concept",
                "weaken-axiom",
                "scope-concept",
                "add-boundary-object",
                "add-concept-sense",
                "revise-relation",
                "deprecate-concept"
              ]
            },
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "atomicChanges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "targetRef",
                  "description"
                ],
                "properties": {
                  "op": {
                    "enum": [
                      "add",
                      "replace",
                      "deprecate",
                      "weaken",
                      "scope",
                      "link"
                    ]
                  },
                  "targetRef": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "compositePattern": {
              "type": "string"
            },
            "preservesRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "weakensRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deprecatesRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "resultingConcepts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label",
                  "definition",
                  "scope"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "definition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "plurality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localInterpretations",
            "translationRules"
          ],
          "properties": {
            "sharedCore": {
              "type": "string"
            },
            "localInterpretations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "viewpointId",
                  "scope",
                  "interpretation",
                  "invariantRefs"
                ],
                "properties": {
                  "viewpointId": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interpretation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "invariantRefs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "translationRules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fromViewpoint",
                  "toViewpoint",
                  "rule",
                  "lossWarning"
                ],
                "properties": {
                  "fromViewpoint": {
                    "type": "string",
                    "minLength": 1
                  },
                  "toViewpoint": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lossWarning": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operation",
              "description",
              "status",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "operation": {
                "enum": [
                  "add-distinction",
                  "split-concept",
                  "weaken-axiom",
                  "scope-concept",
                  "add-boundary-object",
                  "add-concept-sense",
                  "revise-relation",
                  "deprecate-concept",
                  "no-change"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "active",
                  "rejected",
                  "deferred"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "proofObligations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "competencyQuestions",
            "counterexamples",
            "independentFirstPass",
            "minimumIndependentSourceGroups",
            "dissentRetention",
            "rollbackPlan",
            "migrationPlan"
          ],
          "properties": {
            "competencyQuestions": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "counterexamples": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "independentFirstPass": {
              "type": "boolean"
            },
            "minimumIndependentSourceGroups": {
              "type": "integer",
              "minimum": 2
            },
            "dissentRetention": {
              "type": "boolean"
            },
            "rollbackPlan": {
              "type": "string",
              "minLength": 1
            },
            "migrationPlan": {
              "type": "string",
              "minLength": 1
            },
            "ordinaryPersonTest": {
              "type": "string"
            },
            "consistencyIllusionMitigation": {
              "type": "string"
            },
            "evaluationMetrics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "direction",
                  "threshold"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "enum": [
                      "increase",
                      "decrease",
                      "at-least",
                      "at-most"
                    ]
                  },
                  "threshold": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceSourceGroups",
            "argumentRefs",
            "decision",
            "rationale"
          ],
          "properties": {
            "evidenceSourceGroups": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "argumentRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "decision": {
              "enum": [
                "pending",
                "approve",
                "reject",
                "experiment"
              ]
            },
            "decidedBy": {
              "type": "string"
            },
            "decidedAt": {
              "type": "string",
              "format": "date-time"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "invariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "noCanonicalMutationWithoutApproval",
            "preferWeakeningBeforeDeletion",
            "preserveScopedPlurality",
            "retainDissent"
          ],
          "properties": {
            "noCanonicalMutationWithoutApproval": {
              "const": true
            },
            "preferWeakeningBeforeDeletion": {
              "const": true
            },
            "preserveScopedPlurality": {
              "const": true
            },
            "retainDissent": {
              "const": true
            }
          }
        }
      }
    }
  }
}
