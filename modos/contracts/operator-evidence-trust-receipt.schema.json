{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/operator-evidence-trust-receipt-v1.json",
  "title": "Pleiades Operator Evidence Trust Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "candidateId",
    "candidateDigest",
    "registryId",
    "registryDigest",
    "evaluatedAt",
    "state",
    "trustedInputs",
    "blockedInputs",
    "trustedInputCount",
    "requiredInputCount",
    "checks",
    "authority",
    "receiptDigest"
  ],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "OperatorEvidenceTrustReceipt"},
    "candidateId": {"type": "string", "minLength": 1},
    "candidateDigest": {"$ref": "#/$defs/sha256"},
    "registryId": {"type": "string", "minLength": 1},
    "registryDigest": {"$ref": "#/$defs/sha256"},
    "evaluatedAt": {"$ref": "#/$defs/dateTime"},
    "state": {"enum": ["trusted", "blocked"]},
    "trustedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inputId", "attestationId", "issuerRef", "keyRef", "statementDigest", "issuedAt", "expiresAt", "ageSeconds", "status"],
        "properties": {
          "inputId": {"type": "string"},
          "attestationId": {"type": "string"},
          "issuerRef": {"type": "string"},
          "keyRef": {"type": "string"},
          "statementDigest": {"$ref": "#/$defs/sha256"},
          "issuedAt": {"$ref": "#/$defs/dateTime"},
          "expiresAt": {"$ref": "#/$defs/dateTime"},
          "ageSeconds": {"type": "integer", "minimum": 0},
          "status": {"const": "trusted"}
        }
      }
    },
    "blockedInputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trustedInputCount": {"type": "integer", "minimum": 0},
    "requiredInputCount": {"type": "integer", "minimum": 0},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "blocked"]}
        }
      }
    },
    "authority": {
      "const": {
        "ceiling": "none",
        "trustEvaluationOnly": true,
        "authorizationApplied": false,
        "executionApplied": false,
        "registryMutationApplied": false
      }
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
