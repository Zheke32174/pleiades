{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/executive-authorization-receipt-v1.json",
  "title": "Pleiades Executive Authorization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "decisionId", "mandateId", "status", "bindings", "checks", "authority"],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "ExecutiveAuthorizationReceipt"},
    "decisionId": {"type": "string", "minLength": 1},
    "mandateId": {"type": "string", "minLength": 1},
    "status": {"enum": ["authorized", "blocked"]},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mindId", "grantId", "proposalDigest", "decisionDigest", "mandateDigest", "predecessorDigest", "targetDigest", "rollbackDigest"],
      "properties": {
        "mindId": {"type": "string"},
        "grantId": {"type": "string"},
        "proposalDigest": {"$ref": "#/$defs/sha256"},
        "decisionDigest": {"$ref": "#/$defs/sha256"},
        "mandateDigest": {"$ref": "#/$defs/sha256"},
        "predecessorDigest": {"$ref": "#/$defs/sha256"},
        "targetDigest": {"$ref": "#/$defs/sha256"},
        "rollbackDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "blocked"]},
          "detail": {"type": "string"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionPrincipal", "executorDecisionAuthority", "constitutionalMutationApplied", "authorityExpansionApplied", "executionStillPending"],
      "properties": {
        "decisionPrincipal": {"const": "delegated-mind"},
        "executorDecisionAuthority": {"const": "none"},
        "constitutionalMutationApplied": {"const": false},
        "authorityExpansionApplied": {"const": false},
        "executionStillPending": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
