{"$defs":{"dateTime":{"format":"date-time","type":"string"},"sha256":{"pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$","type":"string"}},"$id":"https://pleiades.local/schemas/evidence-attestation-v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"algorithm":{"const":"Ed25519"},"apiVersion":{"const":"modos.pleiades/v1alpha1"},"artifactDigest":{"$ref":"#/$defs/sha256"},"artifactRef":{"maxLength":256,"minLength":3,"type":"string"},"attestationId":{"pattern":"^attestation:[a-z0-9][A-Za-z0-9._:-]{2,191}$","type":"string"},"authority":{"const":{"attestationOnly":true,"authorizationApplied":false,"executionApplied":false}},"candidateDigest":{"$ref":"#/$defs/sha256"},"classification":{"enum":["public-reference","private-reference","sovereign-decision","live-evidence"]},"expiresAt":{"$ref":"#/$defs/dateTime"},"inputId":{"pattern":"^[A-Za-z][A-Za-z0-9]{1,63}$","type":"string"},"issuedAt":{"$ref":"#/$defs/dateTime"},"issuerRef":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{1,255}$","type":"string"},"keyRef":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{1,255}$","type":"string"},"kind":{"const":"EvidenceAttestation"},"nonce":{"pattern":"^[0-9a-f]{64}$","type":"string"},"receiptDigest":{"$ref":"#/$defs/sha256"},"signatureBase64":{"pattern":"^[A-Za-z0-9+/]{86}==$","type":"string"}},"required":["apiVersion","kind","attestationId","candidateDigest","inputId","classification","artifactRef","artifactDigest","receiptDigest","issuerRef","keyRef","issuedAt","expiresAt","nonce","algorithm","authority","signatureBase64"],"title":"Pleiades Evidence Attestation","type":"object"}
