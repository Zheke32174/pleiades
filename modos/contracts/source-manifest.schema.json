{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/ontology-source-manifest-v1.json",
  "title": "Pleiades Ontology Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "manifestId",
    "repository",
    "branch",
    "commitSha",
    "mindId",
    "schemaVersion",
    "subject",
    "artifacts",
    "authority"
  ],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "OntologySourceManifest"},
    "manifestId": {"type": "string", "minLength": 1, "maxLength": 256},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mindId": {"type": "string", "minLength": 1, "maxLength": 128},
    "schemaVersion": {"type": "string", "pattern": "^v[0-9]+(?:alpha[0-9]+|beta[0-9]+)?$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshotDigest", "candidateSnapshotDigest", "closureReceiptDigest"],
      "properties": {
        "sourceSnapshotDigest": {"$ref": "#/$defs/sha256"},
        "candidateSnapshotDigest": {"$ref": "#/$defs/sha256"},
        "closureReceiptDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "role", "locator", "digest", "bytes", "visibility"],
        "properties": {
          "artifactId": {"type": "string", "minLength": 1, "maxLength": 256},
          "role": {
            "enum": [
              "source-snapshot",
              "change-proposal",
              "candidate-snapshot",
              "closure-receipt",
              "compiler",
              "contract",
              "validation-receipt"
            ]
          },
          "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
          "digest": {"$ref": "#/$defs/sha256"},
          "gitBlobSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "visibility": {"enum": ["public", "internal", "private", "steward-only"]}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "pathAuthority", "selfPromotionAllowed"],
      "properties": {
        "ceiling": {"const": "none"},
        "pathAuthority": {"const": "evidence-only"},
        "selfPromotionAllowed": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
