{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/transition-preflight-receipt-v1.json",
  "title": "Pleiades Transition Preflight Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "authorizationId", "status", "evaluatedAt", "bindings", "decision", "quorum", "checks", "blockers", "authority", "receiptDigest"],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "TransitionPreflightReceipt"},
    "authorizationId": {"type": "string"},
    "status": {"enum": ["eligible-for-mandate-construction", "blocked"]},
    "evaluatedAt": {"$ref": "#/$defs/dateTime"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryDigest", "authorizationCandidateDigest", "operatorCandidateDigest", "compilationReceiptDigest", "evidenceTrustReceiptDigest", "planDigest", "grantDigest", "predecessorDigest", "targetDigest", "rollbackDigest"],
      "properties": {
        "registryDigest": {"$ref": "#/$defs/sha256"},
        "authorizationCandidateDigest": {"$ref": "#/$defs/sha256"},
        "operatorCandidateDigest": {"$ref": "#/$defs/sha256"},
        "compilationReceiptDigest": {"$ref": "#/$defs/sha256"},
        "evidenceTrustReceiptDigest": {"$ref": "#/$defs/sha256"},
        "planDigest": {"$ref": "#/$defs/sha256"},
        "grantDigest": {"$ref": "#/$defs/sha256"},
        "predecessorDigest": {"$ref": "#/$defs/sha256"},
        "targetDigest": {"$ref": "#/$defs/sha256"},
        "rollbackDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionType", "authorizationMode", "domain", "action", "riskTier", "executorCapability"],
      "properties": {
        "decisionType": {"type": "string"},
        "authorizationMode": {"type": "string"},
        "domain": {"type": "string"},
        "action": {"type": "string"},
        "riskTier": {"type": "string"},
        "executorCapability": {"type": "string"}
      }
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleApprovals", "independentAuditors", "countedApprovers", "recusedPrincipals", "rejects"],
      "properties": {
        "roleApprovals": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "independentAuditors": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "countedApprovers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "recusedPrincipals": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "rejects": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["pass", "blocked"]}
        }
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {
      "const": {
        "ceiling": "none",
        "preflightOnly": true,
        "mandateConstructed": false,
        "authorizationApplied": false,
        "executionApplied": false,
        "registryMutationApplied": false
      }
    },
    "receiptDigest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "format": "date-time"}
  }
}
