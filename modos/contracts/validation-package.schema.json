{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/validation-package-v1.json",
  "title": "Pleiades MODOS Validation Package Contracts",
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/sbom"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "authority": {
      "const": {"ceiling": "none", "canonicalMutationApplied": false}
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "sourceCommit", "pythonCompatibility", "networkResolutionAllowed", "privateMaterialIncluded", "fileCount", "files", "authority", "manifestDigest"],
      "properties": {
        "apiVersion": {"const": "modos.pleiades/v1alpha1"},
        "kind": {"const": "ValidationPackageManifest"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pythonCompatibility": {"const": ">=3.12,<3.13"},
        "networkResolutionAllowed": {"const": false},
        "privateMaterialIncluded": {"const": false},
        "fileCount": {"type": "integer", "minimum": 1},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileEntry"}},
        "authority": {"$ref": "#/$defs/authority"},
        "manifestDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components"],
      "properties": {
        "bomFormat": {"const": "CycloneDX"},
        "specVersion": {"const": "1.6"},
        "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
        "version": {"const": 1},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "properties"],
          "properties": {
            "component": {"type": "object"},
            "properties": {"type": "array"}
          }
        },
        "components": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "sourceCommit", "manifestDigest", "sbomDigest", "packageDigest", "packageBytes", "fileCount", "reproducibleMetadata", "networkResolutionAllowed", "privateMaterialIncluded", "authority", "receiptDigest"],
      "properties": {
        "apiVersion": {"const": "modos.pleiades/v1alpha1"},
        "kind": {"const": "ValidationPackageReceipt"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "sbomDigest": {"$ref": "#/$defs/digest"},
        "packageDigest": {"$ref": "#/$defs/digest"},
        "packageBytes": {"type": "integer", "minimum": 1},
        "fileCount": {"type": "integer", "minimum": 1},
        "reproducibleMetadata": {"const": true},
        "networkResolutionAllowed": {"const": false},
        "privateMaterialIncluded": {"const": false},
        "authority": {"$ref": "#/$defs/authority"},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
