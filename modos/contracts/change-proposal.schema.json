{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pleiades.local/schemas/change-proposal-v1.json",
  "title": "Pleiades Ontology ChangeProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "proposalId",
    "sourceSnapshotDigest",
    "targetSchemaVersion",
    "mindId",
    "objectFamily",
    "rationale",
    "operations",
    "evidenceRefs",
    "expectedSemanticEffects",
    "rollbackPlan",
    "authority"
  ],
  "properties": {
    "apiVersion": {"const": "modos.pleiades/v1alpha1"},
    "kind": {"const": "ChangeProposal"},
    "proposalId": {"type": "string", "pattern": "^proposal:[a-z0-9][a-z0-9._:-]{7,127}$"},
    "sourceSnapshotDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetSchemaVersion": {"type": "string", "pattern": "^v[0-9]+(?:alpha[0-9]+|beta[0-9]+)?$"},
    "mindId": {"type": "string", "minLength": 1, "maxLength": 128},
    "objectFamily": {
      "enum": [
        "Node", "Resource", "Device", "Workload", "Service",
        "Model", "Mind", "Agent", "CognitiveAssembly", "CognitiveWorkspace"
      ]
    },
    "rationale": {"type": "string", "minLength": 16, "maxLength": 4096},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "objectId"],
        "properties": {
          "op": {"enum": ["create", "update", "delete", "link", "unlink"]},
          "objectId": {"type": "string", "minLength": 1, "maxLength": 256},
          "relationType": {"type": "string", "minLength": 1, "maxLength": 128},
          "targetRef": {"type": "string", "minLength": 1, "maxLength": 256},
          "payload": {"type": "object"}
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "expectedSemanticEffects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "rollbackPlan": {"type": "string", "minLength": 16, "maxLength": 4096},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "canonicalMutation", "promotionTransactionRequired", "selfPromotionAllowed"],
      "properties": {
        "ceiling": {"const": "none"},
        "canonicalMutation": {"const": "forbidden"},
        "promotionTransactionRequired": {"const": true},
        "selfPromotionAllowed": {"const": false}
      }
    }
  }
}
