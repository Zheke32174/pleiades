[Unit]
Description=Pleiades PDK Node Kernel Agent
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/libexec/pleiades/pdk-node-agent --config /etc/pleiades/pdk-node-agent.toml
Restart=always
RestartSec=3s
# The node agent must contact PID 1 through the system D-Bus to create bounded
# transient services. Workloads themselves receive the stronger isolation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/pleiades

[Install]
WantedBy=multi-user.target
