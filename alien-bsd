#!/usr/bin/env python3
"""
alien-bsd — Universal package converter → apt (deb) and Gentoo (tbz2).

Supported source formats:
  FreeBSD  .pkg / .txz          (via +MANIFEST JSON)
  pkgsrc   .tgz                 (via +CONTENTS text)
  Debian   .deb                 (via DEBIAN/control)
  RPM      .rpm                 (via rpm2cpio or cpio header)
  Alpine   .apk                 (via .PKGINFO)
  Arch     .pkg.tar.zst/.xz     (via .PKGINFO)
  Python   .whl                 (via *.dist-info/METADATA)
  npm      .tgz with package.json
  Cargo    .crate (Rust)        (via Cargo.toml)

Output formats:
  --to-deb      Debian .deb  (dpkg-deb or ar fallback)
  --to-gentoo   Gentoo binary .tbz2  (XPAK, emerge --usepkgonly)
  --both        Both formats

Usage:
  alien-bsd [options] <package>

Options:
  --to-deb            Output .deb (default when neither flag given)
  --to-gentoo         Output Gentoo .tbz2
  --both              Both formats
  --no-remap          Keep install prefix paths (don't remap to /usr)
  --category CAT      Override Gentoo category (e.g. dev-libs)
  --output-dir DIR    Output directory (default: .)
  --dry-run           Print plan, write nothing
  -v, --verbose       Verbose file listing
"""

